DB_URL=jdbc:mysql://127.0.0.1:3306/crawler_db?serverTimezone=UTC
DB_USER=your_db_user
DB_PASSWORD=your_db_password
PAPAGO_CLIENT_ID=your_papago_client_id
PAPAGO_CLIENT_SECRET=your_papago_client_secret

# Oracle 전환(진행 중) - DatabaseService가 사용 (KeywordService는 아직 위 MySQL 변수 사용 중)
ORACLE_DB_URL=your_oracle_jdbc_url
ORACLE_DB_USER=your_oracle_user
ORACLE_DB_PASSWORD=your_oracle_password
